rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /crm_store/{docId} {
      allow read, write: if true;
    }
    match /chat_messages/{docId} {
      allow read, write: if true;
    }
    match /utilizadores/{docId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
